# Copy to .env for docker compose. In EKS, put the secret values in a Kubernetes Secret
# (or AWS Secrets Manager + External Secrets) and the rest in a ConfigMap.

# --- Database (secret: DB_PASSWORD) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=paylane
DB_USERNAME=paylane
DB_PASSWORD=change-me
DB_USE_SSL=false
DB_POOL_SIZE=10
# Or give the whole JDBC URL instead of host/port/name:
# DB_URL=jdbc:mysql://my-rds.xxxx.us-east-1.rds.amazonaws.com:3306/paylane?useSSL=true&serverTimezone=UTC
MYSQL_ROOT_PASSWORD=change-me-root

# --- Auth (secret: JWT_SECRET, at least 32 characters, SAME value on every backend replica) ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MINUTES=120

# --- CORS: only needed if the browser calls the backend on a different origin ---
CORS_ALLOWED_ORIGINS=https://paylane.example.com

# --- Wallet rules ---
WALLET_CURRENCY=USD
WALLET_DAILY_LIMIT=5000.00
WALLET_MAX_TXN_AMOUNT=10000.00

# --- Admin account created on first start (secret: ADMIN_PASSWORD) ---
ADMIN_EMAIL=admin@paylane.local
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=Paylane Admin

# --- Frontend container ---
BACKEND_URL=http://backend:8080
